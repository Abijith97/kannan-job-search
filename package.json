{
  "name": "kannan-job-search",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/website.test.mjs",
    "test:website": "node --test tests/website.test.mjs",
    "test:browser": "node scripts/browser-check.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "check:deploy": "npm run build && wrangler deploy --dry-run --outdir tmp/worker-build"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "wrangler": "^4.45.0"
  },
  "engines": { "node": ">=22" }
}
